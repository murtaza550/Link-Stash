{
  "manifest_version": 3,
  "name": "LinkStash",
  "version": "2.0.0",
  "description": "Effortlessly capture and organize links with Alt+Click without opening new tabs. Search, theme, copy, and export anytime.",
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkStash"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}